# ─────────────────────────────────────────────────────────────
# Distributed Job Queue — Environment Configuration
# Copy to .env and fill in your values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
# Full connection string used by Prisma
DATABASE_URL=postgresql://jobqueue:jobqueue_secret@localhost:5432/jobqueue

# Password used by the postgres Docker service
POSTGRES_PASSWORD=jobqueue_secret

# ── Redis ─────────────────────────────────────────────────────
# Full URL used by server and worker (includes auth password)
REDIS_URL=redis://:redis_secret@localhost:6379

# Password used by the redis Docker service
REDIS_PASSWORD=redis_secret

# ── API Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MUST be a long random string in production (min 32 chars — server refuses to start without it)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Token expiration (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:5173

# ── Queue / Retry Policy ──────────────────────────────────────
# Maximum number of attempts before a job is permanently failed
MAX_JOB_ATTEMPTS=3

# Base delay in ms for exponential backoff (doubles each attempt)
# Attempt 1 failure → wait 2s, attempt 2 → wait 4s, attempt 3 → 8s, etc.
RETRY_BASE_DELAY_MS=2000

# ── Worker ────────────────────────────────────────────────────
# Number of concurrent jobs a single worker processes simultaneously
WORKER_CONCURRENCY=2

# How often the worker sends a heartbeat to PostgreSQL (ms)
HEARTBEAT_INTERVAL_MS=10000

# Unique identifier for this worker instance (auto-generated if unset)
# WORKER_INSTANCE=worker-1

# ── Rate Limiting ─────────────────────────────────────────────
# Time window in ms (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# ── Frontend (Vite build-time variables) ──────────────────────
# For Docker: use /api (nginx proxies it) and empty socket URL
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
