{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "description": "Production-style distributed job queue and task scheduler",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix worker && npm install --prefix client",
    "db:generate": "npm run db:generate --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:worker": "npm run dev --prefix worker",
    "dev:client": "npm run dev --prefix client",
    "build:all": "npm run build --prefix server && npm run build --prefix worker && npm run build --prefix client",
    "test": "jest --config jest.config.ts --runInBand --forceExit",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:scale": "docker compose up --scale worker=3",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up --build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.1",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^7.10.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  }
}
