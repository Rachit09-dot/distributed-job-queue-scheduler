{
  "name": "job-queue-worker",
  "version": "1.0.0",
  "description": "Distributed Job Queue - Worker Service",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "start": "node dist/worker.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^5.1.1",
    "distributed-job-scheduler": "file:..",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^7.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.0.0",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "forceExit": true
  }
}
